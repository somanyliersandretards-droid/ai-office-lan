<Window x:Class="AiOfficeLan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Office LAN" Height="820" Width="1280" WindowStartupLocation="CenterScreen" Background="#0f172a">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#111827" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AI Office LAN" Foreground="#e2e8f0" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="  •  secure collaboration shell" Foreground="#94a3b8" FontSize="14" Margin="12,8,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusLabel" Text="Offline" Foreground="#fbbf24" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Margin="0,12,12,0" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="12">
            <StackPanel>
                <TextBlock Text="Office controls" Foreground="#f8fafc" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />

                <Button Content="Host Office" Height="42" Margin="0,0,0,10" Click="HostOffice_Click" Background="#1d4ed8" Foreground="White" FontWeight="SemiBold" />
                <Button Content="Join Office" Height="42" Margin="0,0,0,10" Click="JoinOffice_Click" Background="#0f766e" Foreground="White" FontWeight="SemiBold" />
                <Button Content="Add Sample AI" Height="42" Margin="0,0,0,18" Click="AddSampleAi_Click" Background="#7c3aed" Foreground="White" FontWeight="SemiBold" />

                <TextBlock Text="Connected AIs" Foreground="#cbd5e1" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                <ListBox x:Name="AiListBox" Height="430" Background="#0b1220" Foreground="#e2e8f0" BorderBrush="#334155" BorderThickness="1" DisplayMemberPath="Label" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="12">
            <Grid>
                <TextBlock Text="Virtual office" Foreground="#f8fafc" FontSize="22" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Top" />
                <Canvas x:Name="OfficeCanvas" Margin="0,38,0,0" Background="#0b1220" />
            </Grid>
        </Border>
    </Grid>
</Window>
